# ===== mail-pilot 后端配置样例 =====
# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，绝不提交。

# 会话签名密钥（必填）：生成方式 openssl rand -hex 32
SECRET_KEY=please-change-me-to-a-random-32-bytes-hex

# 登录账号（必填，单用户模式）。公网部署请务必使用强密码。
APP_USERNAME=admin
APP_PASSWORD=please-change-me

# 数据目录（SQLite 与附件存放处，容器部署时挂卷）
DATA_DIR=./data

# 监听
HOST=127.0.0.1
PORT=8000

# 是否启动后台调度器（发送推进/IMAP 同步）；测试或调试时可设为 false
RUN_SCHEDULER=true

# 前端 build 产物目录（存在则由 FastAPI 静态托管；开发模式下留空走 Vite）
STATIC_DIR=../frontend/dist

# 日志级别
LOG_LEVEL=info
