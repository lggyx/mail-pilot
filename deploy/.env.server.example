# ===== mail-pilot 服务器配置样例 =====
# 复制为 deploy/.env.server 后修改；.env.server 已被 .gitignore 排除，绝不提交。

# 会话签名密钥（必填！）：在服务器执行 openssl rand -hex 32 生成
SECRET_KEY=please-change-me-to-a-random-32-bytes-hex

# 登录账号（必填！公网部署务必用强密码）
APP_USERNAME=admin
APP_PASSWORD=please-change-me

# 日志级别
LOG_LEVEL=info

# 后台调度器保持开启（发送推进 / IMAP 同步 / 退信扫描）
RUN_SCHEDULER=true

# ---- 容器内固定项（勿改）----
# DATA_DIR=/app/data
# STATIC_DIR=/app/frontend-dist
# HOST=0.0.0.0 / PORT=8000 由 CMD 指定
